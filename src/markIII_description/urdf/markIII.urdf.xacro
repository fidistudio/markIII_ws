<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="markIII">

    <!-- PREFIX ARGUMENT -->
    <xacro:arg name="prefix" default="" />

    <!-- IMPORT MARKIII MACRO -->
    <xacro:include filename="$(find markIII_description)/urdf/markIII_description.xacro" />

    <!-- IMPORT RVIZ MATERIALS -->
    <xacro:include filename="$(find markIII_description)/urdf/markIII.materials.xacro" />

    <!-- WORLD LINK -->
    <link name="world" />

    <!-- MARKIII ROBOT INSTANCE -->
    <xacro:markIII parent="world" prefix="$(arg prefix)">

        <origin xyz="0 0 0" rpy="0 0 0" />

    </xacro:markIII>

</robot>
